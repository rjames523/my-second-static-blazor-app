@page "/"

<PageTitle>Home</PageTitle>

<h2>Deed Stamp Calculator</h2>
<br />
<h4>Enter Consideration Amount, then click <strong>Calculate</strong>.</h4>

<table style="width:100%">
    <tr>
        <td colspan="2" style="color:red;">
            @InvalidEntryMessage
        </td>
    </tr>

    <tr>
        <td>Consideration Amount:</td>
        <td><input @bind="ConsiderationAmountInput" @bind:event="oninput" /></td>
    </tr>
    <tr>
        <td>State Stamps:</td>
        <td>@stateStampsPrice</td>
    </tr>
    <tr>
        <td>County Stamps:</td>
        <td>@countyStampsPrice</td>
    </tr>
    <tr>
        <td>Total Deed Stamps:</td>
        <td>@totalDeedStampsPrice</td>
    </tr>
    <tr>
        <td  colspan="2" style="padding-top:15px;">
        <button @onclick="CalculateStamps">Calculate</button>
        <button @onclick="ResetForm" style="margin-left:20px">Reset</button>
        </td>
    </tr>

</table>

@code {

    private string stateStampsPrice = "";
    private string countyStampsPrice = "";
    private string totalDeedStampsPrice = "";
    private string ConsiderationAmountInput = "";
    private string InvalidEntryMessage = "";

    private void CalculateStamps()
    {
        InvalidEntryMessage = "";

        if (!decimal.TryParse(ConsiderationAmountInput, out decimal amount) && ConsiderationAmountInput != String.Empty)
        {
            InvalidEntryMessage = "Please enter a valid number.";
            ResetForm();
            return;
        }

        //This section will convert the text that is inputed by the user into a number that will then be divided by 500 to find out how much it would cost the user. Per 500 it's $1.3 for the state and $0.55 for the county with a total being $1.85. Each $500 should work like a bracket, if you are in the next bracket even by only $1 then you are charged $1.85.
        decimal num = amount / 500m;
        decimal state = 0m;
        decimal county = 0m;

        if (num != 0)
        {
            for (int i = 0; i < (int)num; i++)
            {
                state += 1.3m;
                county += 0.55m;
            }

            if ((amount - (500m * (int)num)) > 0)
            {
                state += 1.3m;
                county += 0.55m;
            }
        }
        else
        {
            state = 1.3m;
            county = 0.55m;
        }

        decimal total = state + county;

        stateStampsPrice = $"${state:F2}";
        countyStampsPrice = $"${county:F2}";
        totalDeedStampsPrice = $"${total:F2}";

    }

    private void ResetForm()
    {
        ConsiderationAmountInput = "";
        stateStampsPrice = "";
        countyStampsPrice = "";
        totalDeedStampsPrice = "";
    }
}